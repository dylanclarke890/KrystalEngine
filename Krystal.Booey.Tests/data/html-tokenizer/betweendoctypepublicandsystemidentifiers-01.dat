#name
ignores whitespace and stays in the same state when parsing whitespace
#data
   	

#initial-state
BetweenDOCTYPEPublicAndSystemIdentifiers
#expected-state
BetweenDOCTYPEPublicAndSystemIdentifiers
#tokens

#name
switches to Data and emits DOCTYPE when parsing GreaterThanSign
#data
<!DOCTYPE HTML PUBLIC "id">
#tokens
DOCTYPE(html, id, , ForceQuirks=false)

#name
switches to DOCTYPESystemIdentifierDoubleQuoted when parsing QuotationMark
#data
<!DOCTYPE HTML PUBLIC "id" "
#expected-state
DOCTYPESystemIdentifierDoubleQuoted
#tokens

#name
switches to DOCTYPESystemIdentifierSingleQuoted when parsing Apostrophe
#data
<!DOCTYPE HTML PUBLIC "id" '
#expected-state
DOCTYPESystemIdentifierSingleQuoted
#tokens

#name
emits DOCTYPE with force-quirks when EOF reached
#data
<!DOCTYPE HTML PUBLIC "id"
#append-eof
#tokens
DOCTYPE(html, id, , ForceQuirks=true)
EndOfFile
#errors
1:27 EOFInDOCTYPE

#name
treats anything else as unexpected and switches to BogusDOCTYPE
#data
<!DOCTYPE HTML PUBLIC "id"a
#expected-state
BogusDOCTYPE
