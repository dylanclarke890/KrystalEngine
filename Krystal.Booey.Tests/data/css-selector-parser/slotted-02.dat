$input
::slotted
$expect-invalid

$input
::slotted()
$expect-invalid

$input
::slotted(0)
$expect-invalid

$input
:slotted(foo)
$expect-invalid

$input
::slotted(foo):first-child
$expect-invalid

$input
::slotted(foo):hover
$expect-invalid

$input
::slotted(foo):focus
$expect-invalid

$input
::slotted(foo):lang(en)
$expect-invalid

$input
::slotted(foo):dir(ltr)
$expect-invalid

$input
::slotted(foo) + ::slotted(bar)
$expect-invalid
