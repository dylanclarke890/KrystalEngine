  namespace
  {
    KRYS_NODISCARD bool IsKeywordValidForWritingModeValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::HorizontalTb:
        case CSSValueId::VerticalLr:
        case CSSValueId::VerticalRl:
        case CSSValueId::LrTb:
        case CSSValueId::RlTb:
        case CSSValueId::TbRl:
        case CSSValueId::Lr:
        case CSSValueId::Rl:
        case CSSValueId::Tb:
        case CSSValueId::HorizontalBt:
        {
          return true;
        }
        case CSSValueId::SidewaysLr:
        case CSSValueId::SidewaysRl:
        {
          return context.SidewaysWritingModesEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForDisplayValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::Inline:
        case CSSValueId::Block:
        case CSSValueId::Flow:
        case CSSValueId::FlowRoot:
        case CSSValueId::ListItem:
        case CSSValueId::InlineBlock:
        case CSSValueId::Table:
        case CSSValueId::InlineTable:
        case CSSValueId::TableRowGroup:
        case CSSValueId::TableHeaderGroup:
        case CSSValueId::TableFooterGroup:
        case CSSValueId::TableRow:
        case CSSValueId::TableColumnGroup:
        case CSSValueId::TableColumn:
        case CSSValueId::TableCell:
        case CSSValueId::TableCaption:
        case CSSValueId::Flex:
        case CSSValueId::InlineFlex:
        case CSSValueId::Grid:
        case CSSValueId::InlineGrid:
        case CSSValueId::Ruby:
        case CSSValueId::RubyTextContainer:
        case CSSValueId::RubyBase:
        case CSSValueId::RubyText:
        case CSSValueId::RubyBaseContainer:
        case CSSValueId::Contents:
        case CSSValueId::None:
        case CSSValueId::WebkitBox:
        case CSSValueId::WebkitInlineBox:
        case CSSValueId::WebkitFlex:
        case CSSValueId::WebkitInlineFlex:
        case CSSValueId::Compact:
        case CSSValueId::RunIn:
        {
          return true;
        }
        case CSSValueId::GridLanes:
        case CSSValueId::InlineGridLanes:
        {
          return context.GridLanesEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForFontSizeValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::XSmall:
        case CSSValueId::XxSmall:
        case CSSValueId::Small:
        case CSSValueId::Medium:
        case CSSValueId::Large:
        case CSSValueId::XLarge:
        case CSSValueId::XxLarge:
        case CSSValueId::XxxLarge:
        case CSSValueId::Smaller:
        case CSSValueId::Larger:
        case CSSValueId::WebkitXxxLarge:
        case CSSValueId::WebkitRubyText:
        {
          return true;
        }
        case CSSValueId::Math:
        {
          return context.MathDepthEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

  }

  bool CSSProperty::IsKeywordValidForPropertyValues(CSSPropertyId id, CSSValueId keyword, const CSSParserContext &context) noexcept
  {
    switch (id)
    {
      case CSSPropertyId::WritingMode:
      {
        return IsKeywordValidForWritingModeValues(keyword, context);
      }
      case CSSPropertyId::Direction:
      {
        return std::ranges::find(ValidKeywordsForDirection, keyword) != ValidKeywordsForDirection.end();
      }
      case CSSPropertyId::Display:
      {
        return IsKeywordValidForDisplayValues(keyword, context);
      }
      case CSSPropertyId::FontFamily:
      {
        return std::ranges::find(ValidKeywordsForFontFamily, keyword) != ValidKeywordsForFontFamily.end();
      }
      case CSSPropertyId::FontFeatureSettings:
      {
        return std::ranges::find(ValidKeywordsForFontFeatureSettings, keyword) != ValidKeywordsForFontFeatureSettings.end();
      }
      case CSSPropertyId::FontKerning:
      {
        return std::ranges::find(ValidKeywordsForFontKerning, keyword) != ValidKeywordsForFontKerning.end();
      }
      case CSSPropertyId::FontSize:
      {
        return IsKeywordValidForFontSizeValues(keyword, context);
      }
      case CSSPropertyId::FontSizeAdjust:
      {
        return std::ranges::find(ValidKeywordsForFontSizeAdjust, keyword) != ValidKeywordsForFontSizeAdjust.end();
      }
      case CSSPropertyId::FontStyle:
      {
        return std::ranges::find(ValidKeywordsForFontStyle, keyword) != ValidKeywordsForFontStyle.end();
      }
      case CSSPropertyId::FontSynthesisSmallCaps:
      {
        return std::ranges::find(ValidKeywordsForFontSynthesisSmallCaps, keyword) != ValidKeywordsForFontSynthesisSmallCaps.end();
      }
      case CSSPropertyId::FontSynthesisStyle:
      {
        return std::ranges::find(ValidKeywordsForFontSynthesisStyle, keyword) != ValidKeywordsForFontSynthesisStyle.end();
      }
      case CSSPropertyId::FontSynthesisWeight:
      {
        return std::ranges::find(ValidKeywordsForFontSynthesisWeight, keyword) != ValidKeywordsForFontSynthesisWeight.end();
      }
      case CSSPropertyId::FontVariantCaps:
      {
        return std::ranges::find(ValidKeywordsForFontVariantCaps, keyword) != ValidKeywordsForFontVariantCaps.end();
      }
      case CSSPropertyId::FontVariantEastAsian:
      {
        return std::ranges::find(ValidKeywordsForFontVariantEastAsian, keyword) != ValidKeywordsForFontVariantEastAsian.end();
      }
      case CSSPropertyId::FontVariantEmoji:
      {
        return std::ranges::find(ValidKeywordsForFontVariantEmoji, keyword) != ValidKeywordsForFontVariantEmoji.end();
      }
      case CSSPropertyId::FontVariantLigatures:
      {
        return std::ranges::find(ValidKeywordsForFontVariantLigatures, keyword) != ValidKeywordsForFontVariantLigatures.end();
      }
      case CSSPropertyId::FontVariantNumeric:
      {
        return std::ranges::find(ValidKeywordsForFontVariantNumeric, keyword) != ValidKeywordsForFontVariantNumeric.end();
      }
      case CSSPropertyId::FontVariantPosition:
      {
        return std::ranges::find(ValidKeywordsForFontVariantPosition, keyword) != ValidKeywordsForFontVariantPosition.end();
      }
      case CSSPropertyId::FontWeight:
      {
        return std::ranges::find(ValidKeywordsForFontWeight, keyword) != ValidKeywordsForFontWeight.end();
      }
      case CSSPropertyId::FontWidth:
      {
        return std::ranges::find(ValidKeywordsForFontWidth, keyword) != ValidKeywordsForFontWidth.end();
      }
      case CSSPropertyId::WebkitFontSmoothing:
      {
        return std::ranges::find(ValidKeywordsForWebkitFontSmoothing, keyword) != ValidKeywordsForWebkitFontSmoothing.end();
      }
      case CSSPropertyId::BackgroundImage:
      {
        return std::ranges::find(ValidKeywordsForBackgroundImage, keyword) != ValidKeywordsForBackgroundImage.end();
      }
      case CSSPropertyId::D:
      {
        return std::ranges::find(ValidKeywordsForD, keyword) != ValidKeywordsForD.end();
      }
      case CSSPropertyId::LineHeight:
      {
        return std::ranges::find(ValidKeywordsForLineHeight, keyword) != ValidKeywordsForLineHeight.end();
      }
      case CSSPropertyId::MarginTrim:
      {
        return std::ranges::find(ValidKeywordsForMarginTrim, keyword) != ValidKeywordsForMarginTrim.end();
      }
      case CSSPropertyId::MarginBottom:
      {
        return std::ranges::find(ValidKeywordsForMarginBottom, keyword) != ValidKeywordsForMarginBottom.end();
      }
      case CSSPropertyId::MarginLeft:
      {
        return std::ranges::find(ValidKeywordsForMarginLeft, keyword) != ValidKeywordsForMarginLeft.end();
      }
      case CSSPropertyId::MarginRight:
      {
        return std::ranges::find(ValidKeywordsForMarginRight, keyword) != ValidKeywordsForMarginRight.end();
      }
      case CSSPropertyId::MarginTop:
      {
        return std::ranges::find(ValidKeywordsForMarginTop, keyword) != ValidKeywordsForMarginTop.end();
      }
      case CSSPropertyId::MarginBlockEnd:
      {
        return std::ranges::find(ValidKeywordsForMarginBlockEnd, keyword) != ValidKeywordsForMarginBlockEnd.end();
      }
      case CSSPropertyId::MarginInlineEnd:
      {
        return std::ranges::find(ValidKeywordsForMarginInlineEnd, keyword) != ValidKeywordsForMarginInlineEnd.end();
      }
      case CSSPropertyId::MarginInlineStart:
      {
        return std::ranges::find(ValidKeywordsForMarginInlineStart, keyword) != ValidKeywordsForMarginInlineStart.end();
      }
      default:
      {
        return false;
      }
    }
