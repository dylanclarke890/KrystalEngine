      }
      case CSSPropertyId::MaxBlockSize:
      {
        return std::ranges::find(ValidKeywordsForMaxBlockSize, keyword) != ValidKeywordsForMaxBlockSize.end();
      }
      case CSSPropertyId::MaxInlineSize:
      {
        return std::ranges::find(ValidKeywordsForMaxInlineSize, keyword) != ValidKeywordsForMaxInlineSize.end();
      }
      case CSSPropertyId::MinBlockSize:
      {
        return std::ranges::find(ValidKeywordsForMinBlockSize, keyword) != ValidKeywordsForMinBlockSize.end();
