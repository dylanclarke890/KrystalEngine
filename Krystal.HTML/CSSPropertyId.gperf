  bool operator==(const CSSPropertySettings &a, const CSSPropertySettings &b)
  {
    return a.CornerShapePropertyEnabled == b.CornerShapePropertyEnabled
      && a.DPropertyEnabled == b.DPropertyEnabled
      && a.FontVariantEmojiPropertyEnabled == b.FontVariantEmojiPropertyEnabled;
  }

