  CSSPropertyId FindCSSProperty(CSSOMStringView characters) noexcept
  {
    auto* value = CSSPropertyNamesHash::in_word_set(reinterpret_cast<const char*>(characters.data()), characters.length());
    return value ? static_cast<CSSPropertyId>(value->id) : CSSPropertyId::Invalid;
  }

  CSSOMStringView ToString(CSSPropertyId id) noexcept
  {
    auto value = static_cast<uint16>(id);
    if (value < FirstCSSProperty)
    {
      return {};
    }

    size_t index = value - FirstCSSProperty;
    if (index >= NumCSSProperties)
    {
      return {};
    }

    return PropertyNameStrings[index];
  }

  bool IsInternal(CSSPropertyId id) noexcept
  {
    switch (id)
    {
      {
        return true;
      }
      default:
      {
        return false;
      }
    }
  }

  namespace
  {
    KRYS_NODISCARD bool IsExposedNotInvalidAndNotInternal(CSSPropertyId id, const CSSPropertySettings &settings) noexcept
    {
      switch (id)
      {
        case CSSPropertyId::MathDepth:
        {
          return settings.cssMathDepthEnabled;
        }
        case CSSPropertyId::FontVariantEmoji:
        {
          return settings.cssFontVariantEmojiEnabled;
        }
        case CSSPropertyId::TextAutospace:
        {
          return settings.cssTextAutospaceEnabled;
        }
        case CSSPropertyId::TextSpacingTrim:
        {
          return settings.cssTextSpacingTrimEnabled;
        }
        case CSSPropertyId::AccentColor:
        {
          return settings.accentColorEnabled;
        }
        case CSSPropertyId::AnchorName:
        case CSSPropertyId::AnchorScope:
        case CSSPropertyId::PositionAnchor:
        case CSSPropertyId::PositionArea:
        case CSSPropertyId::PositionTryFallbacks:
        case CSSPropertyId::PositionTryOrder:
        case CSSPropertyId::PositionVisibility:
        case CSSPropertyId::PositionTry:
        {
          return settings.cssAnchorPositioningEnabled;
        }
        case CSSPropertyId::AnimationRangeEnd:
        case CSSPropertyId::AnimationRangeStart:
        case CSSPropertyId::AnimationTimeline:
        case CSSPropertyId::ScrollTimelineAxis:
        case CSSPropertyId::ScrollTimelineName:
        case CSSPropertyId::TimelineScope:
        case CSSPropertyId::ViewTimelineAxis:
        case CSSPropertyId::ViewTimelineInset:
        case CSSPropertyId::ViewTimelineName:
        case CSSPropertyId::AnimationRange:
        case CSSPropertyId::ScrollTimeline:
        case CSSPropertyId::ViewTimeline:
        {
          return settings.scrollDrivenAnimationsEnabled;
        }
        case CSSPropertyId::BackdropFilter:
        {
          return settings.cssUnprefixedBackdropFilterEnabled;
        }
        case CSSPropertyId::BlockEllipsis:
        case CSSPropertyId::Continue:
        case CSSPropertyId::MaxLines:
        case CSSPropertyId::LineClamp:
        {
          return settings.cssLineClampEnabled;
        }
        case CSSPropertyId::BlockStepAlign:
        case CSSPropertyId::BlockStepInsert:
        case CSSPropertyId::BlockStepRound:
        case CSSPropertyId::BlockStepSize:
        case CSSPropertyId::BlockStep:
        {
          return settings.cssRhythmicSizingEnabled;
        }
        case CSSPropertyId::D:
        {
          return settings.cssDPropertyEnabled;
        }
        case CSSPropertyId::DynamicRangeLimit:
        {
          return settings.supportHDRDisplayEnabled;
        }
        case CSSPropertyId::FieldSizing:
        {
          return settings.cssFieldSizingEnabled;
        }
        case CSSPropertyId::InputSecurity:
        {
          return settings.cssInputSecurityEnabled;
        }
        case CSSPropertyId::LineFitEdge:
        {
          return settings.cssLineFitEdgeEnabled;
        }
        case CSSPropertyId::Navigation:
        case CSSPropertyId::Types:
        {
          return settings.crossDocumentViewTransitionsEnabled;
        }
        case CSSPropertyId::OverflowAnchor:
        {
          return settings.cssScrollAnchoringEnabled;
        }
        case CSSPropertyId::Result:
        {
          return settings.cssFunctionAtRuleEnabled;
        }
        case CSSPropertyId::RubyAlign:
        {
          return settings.cssRubyAlignEnabled;
        }
        case CSSPropertyId::RubyOverhang:
        {
          return settings.cssRubyOverhangEnabled;
        }
        case CSSPropertyId::ScrollbarColor:
        {
          return settings.cssScrollbarColorEnabled;
        }
        case CSSPropertyId::ScrollbarGutter:
        {
          return settings.cssScrollbarGutterEnabled;
        }
        case CSSPropertyId::ScrollbarWidth:
        {
          return settings.cssScrollbarWidthEnabled;
        }
        case CSSPropertyId::TextBoxEdge:
        case CSSPropertyId::TextBoxTrim:
        case CSSPropertyId::TextBox:
        {
          return settings.cssTextBoxTrimEnabled;
        }
        case CSSPropertyId::TextGroupAlign:
        {
          return settings.cssTextGroupAlignEnabled;
        }
        case CSSPropertyId::TextJustify:
        {
          return settings.cssTextJustifyEnabled;
        }
        case CSSPropertyId::ViewTransitionClass:
        case CSSPropertyId::ViewTransitionName:
        {
          return settings.viewTransitionsEnabled;
        }
        case CSSPropertyId::AppleColorFilter:
        {
          return settings.colorFilterEnabled;
        }
        case CSSPropertyId::CornerBottomLeftShape:
        case CSSPropertyId::CornerBottomRightShape:
        case CSSPropertyId::CornerTopLeftShape:
        case CSSPropertyId::CornerTopRightShape:
        case CSSPropertyId::CornerEndEndShape:
        case CSSPropertyId::CornerEndStartShape:
        case CSSPropertyId::CornerStartEndShape:
        case CSSPropertyId::CornerStartStartShape:
        case CSSPropertyId::CornerShape:
        {
          return settings.cssCornerShapeEnabled;
        }
        case CSSPropertyId::OverscrollBehaviorX:
        case CSSPropertyId::OverscrollBehaviorY:
        case CSSPropertyId::OverscrollBehaviorBlock:
        case CSSPropertyId::OverscrollBehaviorInline:
        case CSSPropertyId::OverscrollBehavior:
        {
          return settings.overscrollBehaviorEnabled;
        }
        default:
        {
          return true;
        }
      }
    }


    KRYS_NODISCARD bool IsExposed(CSSPropertyId id, const CSSPropertySettings* settings) noexcept
    {
      if (id == CSSPropertyId::Invalid || IsInternal(id))
      {
        return false;
      }

      if (!settings)
      {
        return true;
      }

      return IsExposedNotInvalidAndNotInternal(id, *settings);
    }

    KRYS_NODISCARD bool IsExposed(CSSPropertyId id, const CSSPropertySettings& settings) noexcept
    {
      if (id == CSSPropertyId::Invalid || IsInternal(id))
      {
        return false;
      }

      return IsExposedNotInvalidAndNotInternal(id, settings);
    }

  }
