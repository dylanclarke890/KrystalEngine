      }
      case CSSPropertyId::OverflowInline:
      {
        return std::ranges::find(ValidKeywordsForOverflowInline, keyword) != ValidKeywordsForOverflowInline.end();
      }
      case CSSPropertyId::OverscrollBehaviorBlock:
      {
        return std::ranges::find(ValidKeywordsForOverscrollBehaviorBlock, keyword) != ValidKeywordsForOverscrollBehaviorBlock.end();
      }
      case CSSPropertyId::OverscrollBehaviorInline:
      {
        return std::ranges::find(ValidKeywordsForOverscrollBehaviorInline, keyword) != ValidKeywordsForOverscrollBehaviorInline.end();
      }
      case CSSPropertyId::ScrollPaddingBlockEnd:
      {
        return std::ranges::find(ValidKeywordsForScrollPaddingBlockEnd, keyword) != ValidKeywordsForScrollPaddingBlockEnd.end();
      }
      case CSSPropertyId::ScrollPaddingBlockStart:
      {
        return std::ranges::find(ValidKeywordsForScrollPaddingBlockStart, keyword) != ValidKeywordsForScrollPaddingBlockStart.end();
      }
      case CSSPropertyId::ScrollPaddingInlineEnd:
      {
        return std::ranges::find(ValidKeywordsForScrollPaddingInlineEnd, keyword) != ValidKeywordsForScrollPaddingInlineEnd.end();
      }
      case CSSPropertyId::ScrollPaddingInlineStart:
      {
        return std::ranges::find(ValidKeywordsForScrollPaddingInlineStart, keyword) != ValidKeywordsForScrollPaddingInlineStart.end();
      }
      case CSSPropertyId::WebkitTextOrientation:
      {
        return std::ranges::find(ValidKeywordsForWebkitTextOrientation, keyword) != ValidKeywordsForWebkitTextOrientation.end();
