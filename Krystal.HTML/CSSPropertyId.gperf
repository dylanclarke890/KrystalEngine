    CSSValueId::InlineGridLanes,
    CSSValueId::Ruby,
    CSSValueId::RubyTextContainer,
    CSSValueId::RubyBase,
    CSSValueId::RubyText,
    CSSValueId::RubyBaseContainer,
    CSSValueId::Contents,
    CSSValueId::None,
    CSSValueId::WebkitBox,
    CSSValueId::WebkitInlineBox,
    CSSValueId::WebkitFlex,
