  bool CSSProperty::IsInheritedProperty(CSSPropertyId id) noexcept
  {
    assert(static_cast<size_t>(id) < CSSPropertyIdEnumValueCount);
    assert(id != CSSPropertyId::Invalid);
    return IsInheritedPropertyTable[static_cast<size_t>(id)];
  }

  CSSPropertyId CascadeAliasProperty(CSSPropertyId id) noexcept
  {
    switch (id)
    {
      case CSSPropertyId::WebkitRubyPosition:
      {
        return CSSPropertyId::RubyPosition;
      }
      case CSSPropertyId::WebkitTextCombine:
      {
        return CSSPropertyId::TextCombineUpright;
      }
      default:
      {
        return id;
      }
    }
  }

