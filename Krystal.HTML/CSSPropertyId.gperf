  namespace
  {
    KRYS_NODISCARD bool IsKeywordValidForWritingModeValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::HorizontalTb:
        case CSSValueId::VerticalLr:
        case CSSValueId::VerticalRl:
        case CSSValueId::LrTb:
        case CSSValueId::RlTb:
        case CSSValueId::TbRl:
        case CSSValueId::Lr:
        case CSSValueId::Rl:
        case CSSValueId::Tb:
        case CSSValueId::HorizontalBt:
        {
          return true;
        }
        case CSSValueId::SidewaysLr:
        case CSSValueId::SidewaysRl:
        {
          return context.sidewaysWritingModesEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForDisplayValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::Inline:
        case CSSValueId::Block:
        case CSSValueId::Flow:
        case CSSValueId::FlowRoot:
        case CSSValueId::ListItem:
        case CSSValueId::InlineBlock:
        case CSSValueId::Table:
        case CSSValueId::InlineTable:
        case CSSValueId::TableRowGroup:
        case CSSValueId::TableHeaderGroup:
        case CSSValueId::TableFooterGroup:
        case CSSValueId::TableRow:
        case CSSValueId::TableColumnGroup:
        case CSSValueId::TableColumn:
        case CSSValueId::TableCell:
        case CSSValueId::TableCaption:
        case CSSValueId::Flex:
        case CSSValueId::InlineFlex:
        case CSSValueId::Grid:
        case CSSValueId::InlineGrid:
        case CSSValueId::Contents:
        case CSSValueId::None:
        case CSSValueId::WebkitBox:
        case CSSValueId::WebkitInlineBox:
        case CSSValueId::WebkitFlex:
        case CSSValueId::WebkitInlineFlex:
        {
          return true;
        }
        case CSSValueId::GridLanes:
        case CSSValueId::InlineGridLanes:
        {
          return context.gridLanesEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForFontSizeValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::XSmall:
        case CSSValueId::XxSmall:
        case CSSValueId::Small:
        case CSSValueId::Medium:
        case CSSValueId::Large:
        case CSSValueId::XLarge:
        case CSSValueId::XxLarge:
        case CSSValueId::XxxLarge:
        case CSSValueId::Smaller:
        case CSSValueId::Larger:
        case CSSValueId::WebkitXxxLarge:
        case CSSValueId::WebkitRubyText:
        {
          return true;
        }
        case CSSValueId::Math:
        {
          return context.cssMathDepthEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForAppearanceValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::Checkbox:
        case CSSValueId::Radio:
        case CSSValueId::PushButton:
        case CSSValueId::SquareButton:
        case CSSValueId::Button:
        case CSSValueId::Listbox:
        case CSSValueId::Menulist:
        case CSSValueId::MenulistButton:
        case CSSValueId::Meter:
        case CSSValueId::ProgressBar:
        case CSSValueId::SliderHorizontal:
        case CSSValueId::SliderVertical:
        case CSSValueId::Searchfield:
        case CSSValueId::Textfield:
        case CSSValueId::Textarea:
        case CSSValueId::Auto:
        case CSSValueId::None:
        {
          return true;
        }
        case CSSValueId::Base:
        {
          return context.cssAppearanceBaseEnabled;
        }
        case CSSValueId::DefaultButton:
        {
          return context.useSystemAppearance;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForBackgroundClipValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::BorderBox:
        case CSSValueId::PaddingBox:
        case CSSValueId::ContentBox:
        case CSSValueId::Text:
        case CSSValueId::WebkitText:
        {
          return true;
        }
        case CSSValueId::BorderArea:
        {
          return context.cssBackgroundClipBorderAreaEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForTextTransformValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::None:
        case CSSValueId::Capitalize:
        case CSSValueId::Uppercase:
        case CSSValueId::Lowercase:
        case CSSValueId::FullSizeKana:
        case CSSValueId::FullWidth:
        {
          return true;
        }
        case CSSValueId::MathAuto:
        {
          return context.cssTextTransformMathAutoEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForTextWrapStyleValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::Auto:
        case CSSValueId::Balance:
        case CSSValueId::Stable:
        {
          return true;
        }
        case CSSValueId::Pretty:
        {
          return context.cssTextWrapPrettyEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForWordBreakValues(CSSValueId keyword, const CSSParserContext &context) noexcept
    {
      switch (keyword)
      {
        case CSSValueId::Normal:
        case CSSValueId::BreakAll:
        case CSSValueId::KeepAll:
        case CSSValueId::BreakWord:
        {
          return true;
        }
        case CSSValueId::AutoPhrase:
        {
          return context.cssWordBreakAutoPhraseEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

  }

