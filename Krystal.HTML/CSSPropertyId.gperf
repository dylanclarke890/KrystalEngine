      }
      default:
      {
        return false;
      }
    }
  }

  bool CSSProperty::AcceptsQuirkyColor(CSSPropertyId id) noexcept
  {
    switch (id)
    {
      case CSSPropertyId::Color:
      case CSSPropertyId::BorderBottomColor:
      case CSSPropertyId::BorderLeftColor:
      case CSSPropertyId::BorderRightColor:
      case CSSPropertyId::BorderTopColor:
      case CSSPropertyId::BorderColor:
      {
        return true;
      }
      default:
      {
        return false;
      }
    }
  }

  bool CSSProperty::AcceptsQuirkyLength(CSSPropertyId id) noexcept
  {
    switch (id)
    {
      case CSSPropertyId::FontSize:
      case CSSPropertyId::BorderBottomWidth:
      case CSSPropertyId::BorderLeftWidth:
      case CSSPropertyId::BorderRightWidth:
      case CSSPropertyId::BorderTopWidth:
      case CSSPropertyId::MarginBottom:
      case CSSPropertyId::MarginLeft:
      case CSSPropertyId::MarginRight:
      case CSSPropertyId::MarginTop:
      case CSSPropertyId::PaddingBottom:
      case CSSPropertyId::PaddingLeft:
      case CSSPropertyId::PaddingRight:
      case CSSPropertyId::PaddingTop:
      case CSSPropertyId::BorderWidth:
      case CSSPropertyId::Margin:
      case CSSPropertyId::Padding:
      {
        return true;
      }
      default:
      {
        return false;
      }
    }
  }

  bool CSSProperty::AcceptsQuirkyAngle(CSSPropertyId id) noexcept
  {
    switch (id)
    {
      {
        return true;
      }
      default:
      {
        return false;
      }
    }
  }

  bool operator==(const CSSPropertySettings &a, const CSSPropertySettings &b)
  {
    return a.CornerShapePropertyEnabled == b.CornerShapePropertyEnabled
      && a.DPropertyEnabled == b.DPropertyEnabled
      && a.FontVariantEmojiPropertyEnabled == b.FontVariantEmojiPropertyEnabled
      && a.ScrollDrivenAnimationsEnabled == b.ScrollDrivenAnimationsEnabled;
  }

  constexpr static Array<CSSValueId, 12uz> ValidKeywordsForWritingMode {
    CSSValueId::HorizontalTb,
    CSSValueId::VerticalLr,
    CSSValueId::VerticalRl,
    CSSValueId::SidewaysLr,
    CSSValueId::SidewaysRl,
    CSSValueId::LrTb,
    CSSValueId::RlTb,
    CSSValueId::TbRl,
    CSSValueId::Lr,
    CSSValueId::Rl,
    CSSValueId::Tb,
    CSSValueId::HorizontalBt,
  };

  constexpr static Array<CSSValueId, 2uz> ValidKeywordsForDirection {
    CSSValueId::Ltr,
    CSSValueId::Rtl,
  };

