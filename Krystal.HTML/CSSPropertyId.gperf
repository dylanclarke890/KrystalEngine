      case CSSPropertyId::MinInlineSize:
      {
        return std::ranges::find(ValidKeywordsForMinInlineSize, keyword) != ValidKeywordsForMinInlineSize.end();
      }
      case CSSPropertyId::OverflowBlock:
      {
