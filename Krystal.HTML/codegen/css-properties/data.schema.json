{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "properties": {
      "patternProperties": {
        "^[a-zA-Z-]+$": {
          "type": "object",
          "properties": {
            "initial": { "type": "string" },
            "inherited": { "const": true },
            "codegen-properties": {
              "type": "object",
              "properties": {
                "parser-syntax": { "type": "string" },
                "longhands": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-zA-Z-]+$", "uniqueItems": true },
                  "minItems": 1
                }
              },
              "additionalProperties": false,
              "required": ["parser-syntax"]
            },
            "specification": {
              "type": "object",
              "properties": {
                "category": { "type": "string" },
                "url": { "type": "string", "format": "uri" }
              },
              "required": ["category", "url"]
            }
          },
          "required": ["codegen-properties", "specification"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["properties"]
}
