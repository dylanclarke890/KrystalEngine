Language: Cpp
Standard: Latest
BasedOnStyle: LLVM
ColumnLimit: 110
LineEnding: LF
InsertNewlineAtEOF: true

AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
AllowShortCompoundRequirementOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: Inline

AlignConsecutiveShortCaseStatements:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: true
  AlignCaseColons: false
AlignArrayOfStructures: None
AlignEscapedNewlines: Right
BinPackArguments: true

TabWidth: 2
UseTab: Never
IndentWidth: 2
IndentCaseLabels: true
IndentCaseBlocks: false
IndentRequiresClause: false
IndentWrappedFunctionNames: true
ContinuationIndentWidth: 2
NamespaceIndentation: All
FixNamespaceComments: false
ReflowComments: true
CompactNamespaces: false
WrapNamespaceBodyWithEmptyLines: Never
IndentExternBlock: AfterExternBlock
IndentPPDirectives: BeforeHash
AccessModifierOffset: -2
Cpp11BracedListStyle: true

SortIncludes: CaseInsensitive
IncludeBlocks: Preserve
SortUsingDeclarations: LexicographicNumeric

BreakBeforeConceptDeclarations: Always
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
BreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeColon
BreakFunctionDefinitionParameters: false
BreakBeforeBraces: Allman
BreakAfterAttributes: Never

InsertBraces: true
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1
EmptyLineBeforeAccessModifier: Always
RemoveEmptyLinesInUnwrappedLines: true
RemoveSemicolon: true
RemoveParentheses: Leave
EnumTrailingComma: Insert
NumericLiteralCase: { Prefix: Lower, HexDigit: Upper, Suffix: Lower, ExponentLetter: Lower }

QualifierAlignment: Custom
QualifierOrder: [friend, constexpr, static, inline, const, type]

IntegerLiteralSeparator:
  Binary: 3
  BinaryMinDigits: 7
  Decimal: 3
  DecimalMinDigits: 4
  Hex: 2
  HexMinDigits: 8

KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: false

SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: true
SpaceAroundPointerQualifiers: Default
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeCpp11BracedList: true
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeSquareBrackets: false
SpaceInEmptyBlock: false
SpacesBeforeTrailingComments: 1
SpacesInAngles: Never
SpacesInLineCommentPrefix:
 Minimum: 1
 Maximum: 1
SpacesInParens: Never
MacroBlockBegin: "^BEGIN_STATE|^KRYS_SPECIALIZE_.*_BEGIN$"
MacroBlockEnd: "^END_STATE|^KRYS_SPECIALIZE_.*_END$"
AttributeMacros:
  [KRYS_ALWAYS_INLINE, KRYS_DEPRECATED, KRYS_EMPTY_BASE_CLASS, KRYS_FALLTHROUGH, KRYS_LIFETIME_BOUND, KRYS_LIKELY,
   KRYS_MAYBE_UNUSED, KRYS_NEVER_INLINE, KRYS_NODISCARD, KRYS_NOESCAPE, KRYS_NORETURN, KRYS_NO_UNIQUE_ADDRESS,
   KRYS_RETURNS_NONNULL, KRYS_TRIVIAL_ABI, KRYS_UNLIKELY, KRYS_UNUSED_TYPE_ALIAS]
