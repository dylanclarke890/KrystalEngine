#name
emits DOCTYPE with force-quirks when parsing GreaterThanSign
#data
<!DOCTYPE HTML PUBLIC>
#tokens
DOCTYPE(html, , , ForceQuirks=true)
#errors
1:22 MissingDOCTYPEPublicIdentifier

#name
emits DOCTYPE with force-quirks when EOF reached
