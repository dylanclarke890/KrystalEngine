---
# Only the engine's own modules (and their tests and generated code), not vcpkg or third-party/.
HeaderFilterRegex: '.*[/\\]Krystal\.[A-Za-z.]+[/\\].*'

# Vendored code inside the modules (magic_enum, Khronos's OpenGL headers).
ExcludeHeaderFilterRegex: '.*[/\\](MagicEnum\.hpp|OpenGL[/\\]Official[/\\].*)'

# Auto-fixes are formatted with .clang-format.
FormatStyle: file

WarningsAsErrors: ''

Checks: >
  -*,
  bugprone-assert-side-effect,
  bugprone-branch-clone,
  bugprone-copy-constructor-init,
  bugprone-dangling-handle,
  bugprone-forwarding-reference-overload,
  bugprone-incorrect-roundings,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-move-forwarding-reference,
  bugprone-narrowing-conversions,
  bugprone-parent-virtual-call,
  bugprone-redundant-branch-condition,
  bugprone-suspicious-missing-comma,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare,
  bugprone-swapped-arguments,
  bugprone-unchecked-optional-access,
  bugprone-undelegated-constructor,
  bugprone-unhandled-self-assignment,
  bugprone-unused-raii,
  bugprone-unused-return-value,
  bugprone-use-after-move,
  bugprone-virtual-near-miss,
  clang-analyzer-cplusplus.Move,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-noexcept-move-operations,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-slicing,
  misc-definitions-in-headers,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-throw-by-value-catch-by-reference,
  misc-unused-alias-decls,
  misc-unused-using-decls,
  modernize-avoid-bind,
  modernize-avoid-setjmp-longjmp,
  modernize-avoid-variadic-functions,
  modernize-concat-nested-namespaces,
  modernize-deprecated-ios-base-aliases,
  modernize-min-max-use-initializer-list,
  modernize-pass-by-value,
  modernize-redundant-void-arg,
  modernize-replace-auto-ptr,
  modernize-replace-random-shuffle,
  modernize-shrink-to-fit,
  modernize-unary-static-assert,
  modernize-use-bool-literals,
  modernize-use-constraints,
  modernize-use-default-member-init,
  modernize-use-emplace,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-noexcept,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-scoped-lock,
  modernize-use-starts-ends-with,
  modernize-use-std-numbers,
  modernize-use-transparent-functors,
  modernize-use-uncaught-exceptions,
  modernize-use-using,
  performance-faster-string-find,
  performance-for-range-copy,
  performance-inefficient-vector-operation,
  performance-move-const-arg,
  performance-noexcept-move-constructor,
  performance-unnecessary-value-param,
  portability-restrict-system-includes,
  portability-std-allocator-const,
  readability-container-contains,
  readability-container-size-empty,
  readability-convert-member-functions-to-static,
  readability-duplicate-include,
  readability-else-after-return,
  readability-identifier-naming,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-casting,
  readability-redundant-control-flow,
  readability-redundant-declaration,
  readability-redundant-member-init,
  readability-redundant-smartptr-get,
  readability-static-accessed-through-instance
  
CheckOptions:
  # Engine wrappers instead of std's: Krystal.Core/TypeTraits.hpp and Concepts.hpp.
  portability-restrict-system-includes.Includes: '*,-type_traits,-concepts'

  # krys::move instead of std::move. bugprone-use-after-move and performance-move-const-arg only
  # recognise std::move and can't be configured, so clang-analyzer-cplusplus.Move (which follows the
  # move itself, not the function's name) catches uses after krys::move.
  clang-analyzer-cplusplus.Move:WarnOn: All

  # Moving a member out counts as consuming the parameter (std::get(variant &&) and the like).
  cppcoreguidelines-rvalue-reference-param-not-moved.AllowPartialMove: true
  
  # An unnamed && parameter only selects an overload (a tag, or catching temporaries), so there's nothing to move.
  cppcoreguidelines-rvalue-reference-param-not-moved.IgnoreUnnamedParams: true
  cppcoreguidelines-rvalue-reference-param-not-moved.MoveFunction: '::krys::move'

  # Iterators are cheap to copy and conventionally by value. The check's move fixes insert std::move:
  # change them to krys::move.
  performance-unnecessary-value-param.AllowedTypes: '[Ii]terator$'

  # Namespaces: krys, krys::detail.
  readability-identifier-naming.NamespaceCase: lower_case

# Not enabled but possibly wanted.
#   bugprone-easily-swappable-parameters,
#   cppcoreguidelines-virtual-class-destructor,
#   misc-const-correctness,
#   misc-include-cleaner, Tune IgnoreHeaders for the PCH and unity build first.
#   misc-unused-parameters,
#   modernize-avoid-c-arrays,
#   modernize-avoid-c-style-cast,
#   modernize-deprecated-headers,
#   modernize-loop-convert,
#   modernize-make-shared, Configure MakeSmartPtrFunction first.
#   modernize-make-unique, Configure MakeSmartPtrFunction for CreateUnique first.
#   modernize-raw-string-literal,
#   modernize-return-braced-init-list,
#   modernize-use-designated-initializers,
#   modernize-use-integer-sign-comparison,
#   modernize-use-ranges,
#   modernize-use-std-format,
#   modernize-use-std-print,
#   performance-unnecessary-copy-initialization,
#   readability-implicit-bool-conversion,
#   readability-make-member-function-const,
#   readability-simplify-boolean-expr,
