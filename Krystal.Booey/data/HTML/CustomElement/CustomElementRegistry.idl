[Exposed=Window]
interface CustomElementRegistry {
  constructor();

  [CEReactions] undefined define(dom::DOMString name, CustomElementConstructor constructor, optional ElementDefinitionOptions options = {});
  (CustomElementConstructor or undefined) get(dom::DOMString name);
  dom::DOMString? getName(CustomElementConstructor constructor);
  Promise<CustomElementConstructor> whenDefined(dom::DOMString name);
  [CEReactions] undefined upgrade(Node root);
  [CEReactions] undefined initialize(Node root);
};

callback CustomElementConstructor = HTMLElement ();

dictionary ElementDefinitionOptions {
  dom::DOMString extends;
};