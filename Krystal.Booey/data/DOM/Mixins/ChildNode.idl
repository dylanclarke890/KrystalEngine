interface mixin ChildNode {
  [CEReactions, Unscopable] undefined before((Node or dom::DOMString)... nodes);
  [CEReactions, Unscopable] undefined after((Node or dom::DOMString)... nodes);
  [CEReactions, Unscopable] undefined replaceWith((Node or dom::DOMString)... nodes);
  [CEReactions, Unscopable] undefined remove();
};
DocumentType includes ChildNode;
Element includes ChildNode;
CharacterData includes ChildNode;