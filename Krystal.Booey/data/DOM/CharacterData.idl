interface CharacterData : Node {
  attribute [LegacyNullToEmptyString] dom::DOMString data;
  readonly attribute unsigned long length;
  dom::DOMString substringData(unsigned long offset, unsigned long count);
  undefined appendData(dom::DOMString data);
  undefined insertData(unsigned long offset, dom::DOMString data);
  undefined deleteData(unsigned long offset, unsigned long count);
  undefined replaceData(unsigned long offset, unsigned long count, dom::DOMString data);
};