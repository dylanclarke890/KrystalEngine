  PropertyId FindProperty(CSSOMStringView characters) noexcept
  {
    auto* value = PropertyNamesHash::in_word_set(reinterpret_cast<const char*>(characters.data()), characters.length());
    return value ? static_cast<PropertyId>(value->id) : PropertyId::Invalid;
  }

  CSSOMStringView ToString(PropertyId id) noexcept
  {
    auto value = static_cast<uint16>(id);
    if (value < FirstProperty)
    {
      return {};
    }

    size_t index = value - FirstProperty;
    if (index >= TotalProperties)
    {
      return {};
    }

    return PropertyNameStrings[index];
  }

  bool IsInternal(PropertyId id) noexcept
  {
    return false;
  }
  namespace
  {
    KRYS_NODISCARD bool IsExposedNotInvalidAndNotInternal(PropertyId id, const PropertySettings &settings) noexcept
    {
      switch (id)
      {
        case PropertyId::MathDepth:
        {
          return settings.cssMathDepthEnabled;
        }
        case PropertyId::FontVariantEmoji:
        {
          return settings.cssFontVariantEmojiEnabled;
        }
        case PropertyId::TextAutospace:
        {
          return settings.cssTextAutospaceEnabled;
        }
        case PropertyId::TextSpacingTrim:
        {
          return settings.cssTextSpacingTrimEnabled;
        }
        case PropertyId::AccentColor:
        {
          return settings.accentColorEnabled;
        }
        case PropertyId::AnchorName:
        case PropertyId::AnchorScope:
        case PropertyId::PositionAnchor:
        case PropertyId::PositionArea:
        case PropertyId::PositionTryFallbacks:
        case PropertyId::PositionTryOrder:
        case PropertyId::PositionVisibility:
        case PropertyId::PositionTry:
        {
          return settings.cssAnchorPositioningEnabled;
        }
        case PropertyId::AnimationRangeEnd:
        case PropertyId::AnimationRangeStart:
        case PropertyId::AnimationTimeline:
        case PropertyId::ScrollTimelineAxis:
        case PropertyId::ScrollTimelineName:
        case PropertyId::TimelineScope:
        case PropertyId::ViewTimelineAxis:
        case PropertyId::ViewTimelineInset:
        case PropertyId::ViewTimelineName:
        case PropertyId::AnimationRange:
        case PropertyId::ScrollTimeline:
        case PropertyId::ViewTimeline:
        {
          return settings.scrollDrivenAnimationsEnabled;
        }
        case PropertyId::BackdropFilter:
        {
          return settings.cssUnprefixedBackdropFilterEnabled;
        }
        case PropertyId::BlockEllipsis:
        case PropertyId::Continue:
        case PropertyId::MaxLines:
        case PropertyId::LineClamp:
        {
          return settings.cssLineClampEnabled;
        }
        case PropertyId::BlockStepAlign:
        case PropertyId::BlockStepInsert:
        case PropertyId::BlockStepRound:
        case PropertyId::BlockStepSize:
        case PropertyId::BlockStep:
        {
          return settings.cssRhythmicSizingEnabled;
        }
        case PropertyId::D:
        {
          return settings.cssDPropertyEnabled;
        }
        case PropertyId::DynamicRangeLimit:
        {
          return settings.supportHDRDisplayEnabled;
        }
        case PropertyId::FieldSizing:
        {
          return settings.cssFieldSizingEnabled;
        }
        case PropertyId::InputSecurity:
        {
          return settings.cssInputSecurityEnabled;
        }
        case PropertyId::LineFitEdge:
        {
          return settings.cssLineFitEdgeEnabled;
        }
        case PropertyId::Navigation:
        case PropertyId::Types:
        {
          return settings.crossDocumentViewTransitionsEnabled;
        }
        case PropertyId::OverflowAnchor:
        {
          return settings.cssScrollAnchoringEnabled;
        }
        case PropertyId::Result:
        {
          return settings.cssFunctionAtRuleEnabled;
        }
        case PropertyId::RubyAlign:
        {
          return settings.cssRubyAlignEnabled;
        }
        case PropertyId::RubyOverhang:
        {
          return settings.cssRubyOverhangEnabled;
        }
        case PropertyId::ScrollbarColor:
        {
          return settings.cssScrollbarColorEnabled;
        }
        case PropertyId::ScrollbarGutter:
        {
          return settings.cssScrollbarGutterEnabled;
        }
        case PropertyId::ScrollbarWidth:
        {
          return settings.cssScrollbarWidthEnabled;
        }
        case PropertyId::TextBoxEdge:
        case PropertyId::TextBoxTrim:
        case PropertyId::TextBox:
        {
          return settings.cssTextBoxTrimEnabled;
        }
        case PropertyId::TextGroupAlign:
        {
          return settings.cssTextGroupAlignEnabled;
        }
        case PropertyId::TextJustify:
        {
          return settings.cssTextJustifyEnabled;
        }
        case PropertyId::ViewTransitionClass:
        case PropertyId::ViewTransitionName:
        {
          return settings.viewTransitionsEnabled;
        }
        case PropertyId::AppleColorFilter:
        {
          return settings.colorFilterEnabled;
        }
        case PropertyId::CornerBottomLeftShape:
        case PropertyId::CornerBottomRightShape:
        case PropertyId::CornerTopLeftShape:
        case PropertyId::CornerTopRightShape:
        case PropertyId::CornerEndEndShape:
        case PropertyId::CornerEndStartShape:
        case PropertyId::CornerStartEndShape:
        case PropertyId::CornerStartStartShape:
        case PropertyId::CornerShape:
        {
          return settings.cssCornerShapeEnabled;
        }
        case PropertyId::OverscrollBehaviorX:
        case PropertyId::OverscrollBehaviorY:
        case PropertyId::OverscrollBehaviorBlock:
        case PropertyId::OverscrollBehaviorInline:
        case PropertyId::OverscrollBehavior:
        {
          return settings.overscrollBehaviorEnabled;
        }
        default:
        {
          return true;
        }
      }
    }

    KRYS_NODISCARD bool IsExposed(PropertyId id, const PropertySettings *settings) noexcept
    {
      if (id == PropertyId::Invalid || IsInternal(id))
      {
        return false;
      }

      if (!settings)
      {
        return true;
      }

      return IsExposedNotInvalidAndNotInternal(id, *settings);
    }

    KRYS_NODISCARD bool IsExposed(PropertyId id, const PropertySettings &settings) noexcept
    {
      if (id == PropertyId::Invalid || IsInternal(id))
      {
        return false;
      }

      return IsExposedNotInvalidAndNotInternal(id, settings);
    }

  }
