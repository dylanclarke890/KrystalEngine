  Span<const ValueId> Property::ValidKeywordsForProperty(PropertyId id) noexcept
  {
    switch (id)
    {
      case PropertyId::MathDepth:
      {
        return Span<const ValueId> {ValidKeywordsForMathDepth};
      }
      case PropertyId::RubyPosition:
      {
        return Span<const ValueId> {ValidKeywordsForRubyPosition};
      }
      case PropertyId::WritingMode:
      {
        return Span<const ValueId> {ValidKeywordsForWritingMode};
      }
      case PropertyId::Direction:
      {
        return Span<const ValueId> {ValidKeywordsForDirection};
      }
      case PropertyId::Display:
      {
        return Span<const ValueId> {ValidKeywordsForDisplay};
      }
      case PropertyId::FontFamily:
      {
        return Span<const ValueId> {ValidKeywordsForFontFamily};
      }
      case PropertyId::FontFeatureSettings:
      {
        return Span<const ValueId> {ValidKeywordsForFontFeatureSettings};
      }
      case PropertyId::FontKerning:
      {
        return Span<const ValueId> {ValidKeywordsForFontKerning};
      }
      case PropertyId::FontSize:
      {
        return Span<const ValueId> {ValidKeywordsForFontSize};
      }
      case PropertyId::FontSizeAdjust:
      {
        return Span<const ValueId> {ValidKeywordsForFontSizeAdjust};
      }
      case PropertyId::FontStyle:
      {
        return Span<const ValueId> {ValidKeywordsForFontStyle};
      }
