  PropertyId Property::ResolveDirectionAwareProperty(PropertyId id, WritingMode writingMode) noexcept
  {
    switch (id)
    {
      case PropertyId::BorderBlockEndColor:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopColor, PropertyId::BorderRightColor, PropertyId::BorderBottomColor, PropertyId::BorderLeftColor};
        return properties[static_cast<size_t>(MapSideLogicalToPhysical(writingMode, LogicalBoxSide::BlockEnd))];
      }
      case PropertyId::BorderBlockStartColor:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopColor, PropertyId::BorderRightColor, PropertyId::BorderBottomColor, PropertyId::BorderLeftColor};
        return properties[static_cast<size_t>(MapSideLogicalToPhysical(writingMode, LogicalBoxSide::BlockStart))];
      }
      case PropertyId::BorderInlineEndColor:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopColor, PropertyId::BorderRightColor, PropertyId::BorderBottomColor, PropertyId::BorderLeftColor};
        return properties[static_cast<size_t>(MapSideLogicalToPhysical(writingMode, LogicalBoxSide::InlineEnd))];
      }
      case PropertyId::BorderInlineStartColor:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopColor, PropertyId::BorderRightColor, PropertyId::BorderBottomColor, PropertyId::BorderLeftColor};
        return properties[static_cast<size_t>(MapSideLogicalToPhysical(writingMode, LogicalBoxSide::InlineStart))];
      }
      case PropertyId::BorderEndEndRadius:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopLeftRadius, PropertyId::BorderTopRightRadius, PropertyId::BorderBottomLeftRadius, PropertyId::BorderBottomRightRadius};
        return properties[static_cast<size_t>(MapCornerLogicalToPhysical(writingMode, LogicalBoxCorner::EndEnd))];
      }
      case PropertyId::BorderEndStartRadius:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopLeftRadius, PropertyId::BorderTopRightRadius, PropertyId::BorderBottomLeftRadius, PropertyId::BorderBottomRightRadius};
        return properties[static_cast<size_t>(MapCornerLogicalToPhysical(writingMode, LogicalBoxCorner::EndStart))];
      }
      case PropertyId::BorderStartEndRadius:
      {
        constexpr static PropertyId properties[4] = {PropertyId::BorderTopLeftRadius, PropertyId::BorderTopRightRadius, PropertyId::BorderBottomLeftRadius, PropertyId::BorderBottomRightRadius};
        return properties[static_cast<size_t>(MapCornerLogicalToPhysical(writingMode, LogicalBoxCorner::StartEnd))];
      }
      case PropertyId::BorderStartStartRadius:
