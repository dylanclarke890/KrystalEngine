  namespace
  {
    KRYS_NODISCARD bool IsKeywordValidForWritingModeValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::HorizontalTb:
        case ValueId::VerticalLr:
        case ValueId::VerticalRl:
        case ValueId::LrTb:
        case ValueId::RlTb:
        case ValueId::TbRl:
        case ValueId::Lr:
        case ValueId::Rl:
        case ValueId::Tb:
        case ValueId::HorizontalBt:
        {
          return true;
        }
        case ValueId::SidewaysLr:
        case ValueId::SidewaysRl:
        {
          return context.sidewaysWritingModesEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForDisplayValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::Inline:
        case ValueId::Block:
        case ValueId::Flow:
        case ValueId::FlowRoot:
        case ValueId::ListItem:
        case ValueId::InlineBlock:
        case ValueId::Table:
        case ValueId::InlineTable:
        case ValueId::TableRowGroup:
        case ValueId::TableHeaderGroup:
        case ValueId::TableFooterGroup:
        case ValueId::TableRow:
        case ValueId::TableColumnGroup:
        case ValueId::TableColumn:
        case ValueId::TableCell:
        case ValueId::TableCaption:
        case ValueId::Flex:
        case ValueId::InlineFlex:
        case ValueId::Grid:
        case ValueId::InlineGrid:
        case ValueId::Contents:
        case ValueId::None:
        case ValueId::WebkitBox:
        case ValueId::WebkitInlineBox:
        case ValueId::WebkitFlex:
        case ValueId::WebkitInlineFlex:
        {
          return true;
        }
        case ValueId::GridLanes:
        case ValueId::InlineGridLanes:
        {
          return context.gridLanesEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForFontSizeValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::XSmall:
        case ValueId::XxSmall:
        case ValueId::Small:
        case ValueId::Medium:
        case ValueId::Large:
        case ValueId::XLarge:
        case ValueId::XxLarge:
        case ValueId::XxxLarge:
        case ValueId::Smaller:
        case ValueId::Larger:
        case ValueId::WebkitXxxLarge:
        case ValueId::WebkitRubyText:
        {
          return true;
        }
        case ValueId::Math:
        {
          return context.cssMathDepthEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForAppearanceValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::Checkbox:
        case ValueId::Radio:
        case ValueId::PushButton:
        case ValueId::SquareButton:
        case ValueId::Button:
        case ValueId::Listbox:
        case ValueId::Menulist:
        case ValueId::MenulistButton:
        case ValueId::Meter:
        case ValueId::ProgressBar:
        case ValueId::SliderHorizontal:
        case ValueId::SliderVertical:
        case ValueId::Searchfield:
        case ValueId::Textfield:
        case ValueId::Textarea:
        case ValueId::Auto:
        case ValueId::None:
        {
          return true;
        }
        case ValueId::Base:
        {
          return context.cssAppearanceBaseEnabled;
        }
        case ValueId::DefaultButton:
        {
          return context.useSystemAppearance;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForBackgroundClipValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::BorderBox:
        case ValueId::PaddingBox:
        case ValueId::ContentBox:
        case ValueId::Text:
        case ValueId::WebkitText:
        {
          return true;
        }
        case ValueId::BorderArea:
        {
          return context.cssBackgroundClipBorderAreaEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForTextTransformValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::None:
        case ValueId::Capitalize:
        case ValueId::Uppercase:
        case ValueId::Lowercase:
        case ValueId::FullSizeKana:
        case ValueId::FullWidth:
        {
          return true;
        }
        case ValueId::MathAuto:
        {
          return context.cssTextTransformMathAutoEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForTextWrapStyleValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::Auto:
        case ValueId::Balance:
        case ValueId::Stable:
        {
          return true;
        }
        case ValueId::Pretty:
        {
          return context.cssTextWrapPrettyEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

    KRYS_NODISCARD bool IsKeywordValidForWordBreakValues(ValueId keyword, const ParserContext &context) noexcept
    {
      switch (keyword)
      {
        case ValueId::Normal:
        case ValueId::BreakAll:
        case ValueId::KeepAll:
        case ValueId::BreakWord:
        {
          return true;
        }
        case ValueId::AutoPhrase:
        {
          return context.cssWordBreakAutoPhraseEnabled;
        }
        default:
        {
          return false;
        }
      }
    }

  }

  bool Property::IsKeywordValidForPropertyValues(PropertyId id, ValueId keyword, const ParserContext &context) noexcept
  {
    switch (id)
    {
      case PropertyId::MathDepth:
      {
        return std::ranges::find(ValidKeywordsForMathDepth, keyword) != ValidKeywordsForMathDepth.end();
