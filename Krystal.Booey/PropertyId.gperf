  bool Property::IsInheritedProperty(PropertyId id) noexcept
  {
    assert(static_cast<size_t>(id) < TotalPropertyIdValues);
    assert(id != PropertyId::Invalid);
    return IsInheritedPropertyTable[static_cast<size_t>(id)];
  }

  PropertyId CascadeAliasProperty(PropertyId id) noexcept
  {
    switch (id)
    {
      case PropertyId::WebkitRubyPosition:
      {
        return PropertyId::RubyPosition;
      }
      case PropertyId::WebkitTextCombine:
      {
        return PropertyId::TextCombineUpright;
      }
      default:
      {
        return id;
      }
    }
  }
